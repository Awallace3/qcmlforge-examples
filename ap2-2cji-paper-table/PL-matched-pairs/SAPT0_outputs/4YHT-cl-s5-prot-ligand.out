set {
basis aug-cc-pv(d+d)z
freeze_core true
scf_type df
mp_type df
}

e,wfn = energy('fisapt0', return_wfn=True)

data_dict = {**variables(), **wfn.variables()}
for k, v in data_dict.items():
    if isinstance(v, core.Matrix):
        data_dict[k] = v.np

import pickle
with open('4YHT-cl-s5-prot-ligand.pkl', 'wb') as fp:
    pickle.dump(data_dict, fp)
